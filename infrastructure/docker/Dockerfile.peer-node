FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/peer-node/ ./apps/peer-node/

RUN npm install

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PEER_PORT=5001
ENV DHT_PORT=6001
ENV PEER_STORAGE_DIR=/data/chunks

VOLUME [ "/data/chunks" ]

COPY --from=builder /app /app

EXPOSE 5001 6001/udp

CMD ["npx", "tsx", "apps/peer-node/src/index.ts"]
